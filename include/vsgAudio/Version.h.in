#ifndef VSGAUDIO_VERSION_H
#define VSGAUDIO_VERSION_H 1

#include <string>

#include <vsgAudio/Export.h>

/**
 * \mainpage
 * VSGAUDIO is an library for integration of 3D sound APIs like OpenAL++ or FMOD into VulkanSceneGraph.
 * This project also includes the OpenAL++ library. OpenAL++ is a C++ abstraction layer
 * on top of OpenAL with additional functionality of reading ogg-files, reference counting etc.
 *
 * VSGAUDIO has been tested on Windows and Linux.
 *
 */

#define VSGAUDIO_MAJOR_VERSION (@VSGAUDIO_MAJOR_VERSION@)
#define VSGAUDIO_MINOR_VERSION (@VSGAUDIO_MINOR_VERSION@)
#define VSGAUDIO_SUB_VERSION (@VSGAUDIO_SUB_VERSION@)

// C preprocessor integrated version number.
// The form is Mmmss, where:
//   M is the major version
//   mm is the minor version (zero-padded)
//   ss is the sub version (zero padded)
// Use this in version-specific code, for example:
//   #if( VSGAUDIO_VERSION > 20100 )
//      ... code specific to releases AFTER v2.01
//   #endif
#define VSGAUDIO_VERSION ( \
        ( VSGAUDIO_MAJOR_VERSION * 10000 ) + \
        ( VSGAUDIO_MINOR_VERSION * 100 ) + \
        VSGAUDIO_SUB_VERSION )

///Define whether we are using OpenAL or FMOD

/// Integration of 3D Sound into VulkanSceneGraph.
namespace vsgAudio {
    VSGAUDIO_EXPORT std::string getVersion();
    VSGAUDIO_EXPORT unsigned int getVersionNumber();
    VSGAUDIO_EXPORT std::string getLibraryName();
} // namespace VSGAUDIO

#endif // VSGAUDIO_VERSION_H

